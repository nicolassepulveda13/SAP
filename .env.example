# Copiar a ".env" (mismo directorio que docker-compose.yml) para cambiar los valores por defecto.

# Contraseña del usuario "sa" de SQL Server: mínimo 8 caracteres con mayúsculas, minúsculas, números y símbolos
DB_PASSWORD=Silverback.2026!

# Firma de los JWT: cadena aleatoria de 32 caracteres o más
JWT_SECRET=cambiar-este-secreto-por-uno-largo-de-32-caracteres-o-mas

# true = carga usuarios y clanes de demo si la base está vacía
SEMBRAR_DEMO=true

# Development = habilita Scalar (/scalar/v1). Production = sin documentación de la API
API_ENV=Development

# Puertos en la PC (cambiarlos si ya están ocupados, por ejemplo por la API o el front de desarrollo)
WEB_PORT=3000
API_PORT=5057
DB_PORT=14333
